{
  "ConnectionStrings": {
    "Database": "Server=staynest.db,1433;Database=StayNest;User Id=sa;Password=Root1234;Trusted_Connection=False;TrustServerCertificate=true",
    "Cache": "staynest-redis:6379"
  },

  "Serilog": {
    "Using": [ "Serilog.Sinks.Console", "Serilog.Sinks.Seq" ],
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Information"
      }
    },
    "WriteTo": [
      { "Name": "Console" },
      {
        "Name": "Seq",
        "Args": { "serverUrl": "http://staynest-seq:5341" }
      }
    ],
    "Enrich": [ "FromLogContext", "WithMachineName", "WithThreadId" ]
  },

  "Authentication": {
    "Audience": "account",
    "ValidIssuer": "http://staynest-idp:8080/realms/staynest",
    "MetadataUrl": "http://staynest-idp:8080/realms/staynest/.well-known/openid-configuration",
    "RequireHttpsMetadata": false
  },

  "Keycloak": {
    "BaseUrl": "http://staynest-idp:8080",
    "AdminUrl": "http://staynest-idp:8080/admin/realms/staynest/",
    "TokenUrl": "http://staynest-idp:8080/realms/staynest/protocol/openid-connect/token",
    "AdminClientId": "staynest-admin-client",
    "AdminClientSecret": "YOUR_ADMIN_CLIENT_SECRET",
    "AuthClientId": "staynest-auth-client",
    "AuthClientSecret": "YOUR_AUTH_CLIENT_SECRET"
  }

}
